{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": null,
  "outputDirectory": "src",
  "redirects": [
    {
      "source": "/sdk/en/:path*",
      "destination": "/sdk/:path*",
      "permanent": true
    },
    {
      "source": "/sdk/README.html",
      "destination": "/sdk/overview.html",
      "permanent": true
    },
    {
      "source": "/sdk/:lang(es|it)/README.html",
      "destination": "/sdk/:lang/overview.html",
      "permanent": true
    },
    {
      "source": "/sdk/CHANGELOG.html",
      "destination": "/sdk/changelog.html",
      "permanent": true
    },
    {
      "source": "/sdk/:lang(es|it)/CHANGELOG.html",
      "destination": "/sdk/:lang/changelog.html",
      "permanent": true
    },
    {
      "source": "/sdk/LICENSE.html",
      "destination": "/sdk/license.html",
      "permanent": true
    },
    {
      "source": "/sdk/:lang(es|it)/LICENSE.html",
      "destination": "/sdk/:lang/license.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
